/* ==========================================================================
   NetMedic theme — "netmedic-dark" v3
   A professional dark theme tuned for long sessions in Windows Terminal.

   Changes in v3:
   - Added ModalScreen / VerticalScroll base styling
   - Improved Header with subtitle contrast
   - Better Label styling for dialogs
   - Refined Tooltip with subtle border glow
   - Consistent color palette across all components
   - Improved Button disabled state
   - Added LoadingIndicator styling

   Color palette (Tailwind-inspired slate/blue):
     Base:    #0b1016  Surface: #0f172a  Panel:   #1e293b
     Border:  #334155  Muted:   #64748b  Text:    #d6dde6
     Bright:  #e5edf6  Blue:    #3b82f6  Cyan:    #0e7490
     Green:   #22c55e  Yellow:  #f59e0b  Red:     #ef4444
     Purple:  #8b5cf6
   ========================================================================== */

App {
    background: #0b1016;
    color: #d6dde6;
}

/* ----- Header / Footer ------------------------------------------------- */
Header {
    background: #111822;
    color: #8ab4ff;
    dock: top;
}

Footer {
    background: #111822;
    color: #94a3b8;
    dock: bottom;
}

/* ----- Main layout: table + details ------------------------------------ */
#main {
    height: 1fr;
}

/* ----- Inputs (search box) -------------------------------------------- */
Input {
    background: #0a0e13;
    border: tall #2b5fab;
    color: #e5edf6;
    padding: 0 1;
}

Input:focus {
    border: tall #7fb0ff;
    background: #0d1219;
}

Input:focus-within {
    border: tall #7fb0ff;
}

/* ----- DataTable ------------------------------------------------------- */
DataTable {
    background: #0b1016;
    color: #e5edf6;
    border: round #223042;
}

DataTable > .datatable--header {
    background: #111822;
    color: #8ab4ff;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #1e3a5f;
}

DataTable > .datatable--hover {
    background: #162030;
}

DataTable > .datatable--even {
    background: #0d1219;
}

DataTable > .datatable--odd {
    background: #0b1016;
}

/* ----- Scrollbars ----------------------------------------------------- */
Scrollbar {
    background: #161b22;
}

Scrollbar > .scrollbar--thumb {
    background: #4e8df5;
}

Scrollbar > .scrollbar--thumb:hover {
    background: #7fb0ff;
}

Scrollbar > .scrollbar--button {
    background: #2b3d54;
}

/* ----- Static / Label text -------------------------------------------- */
Static {
    color: #d6dde6;
}

Label {
    color: #94a3b8;
}

/* ----- Buttons -------------------------------------------------------- */
Button {
    background: #17212d;
    color: #e5edf6;
    border: tall #2b3d54;
    padding: 0 2;
    min-width: 10;
    height: 3;
}

Button:hover {
    background: #213247;
    border: tall #4e8df5;
}

Button:focus {
    border: tall #7fb0ff;
}

Button:disabled {
    background: #111822;
    color: #475569;
    border: tall #1e293b;
}

/* Button variants */
Button.-primary {
    background: #214d86;
    border: tall #3b82f6;
}

Button.-primary:hover {
    background: #2b6cb0;
    border: tall #60a5fa;
}

Button.-success {
    background: #166534;
    border: tall #22c55e;
}

Button.-success:hover {
    background: #15803d;
    border: tall #4ade80;
}

Button.-warning {
    background: #854d0e;
    border: tall #f59e0b;
}

Button.-warning:hover {
    background: #a16207;
    border: tall #fbbf24;
}

Button.-error {
    background: #7b2431;
    border: tall #ef4444;
}

Button.-error:hover {
    background: #991b1b;
    border: tall #f87171;
}

/* ----- Tooltips ------------------------------------------------------- */
Tooltip {
    background: #1e293b;
    color: #e2e8f0;
    border: round #475569;
    padding: 0 1;
}

/* ----- Select (dropdown) ---------------------------------------------- */
Select {
    background: #0a0e13;
    border: round #2b5fab;
    color: #e5edf6;
}

Select:focus {
    border: round #7fb0ff;
}

/* ----- Modal screens -------------------------------------------------- */
ModalScreen {
    background: #0b1016ee;
}

VerticalScroll {
    background: transparent;
}

/* ----- Loading indicator ---------------------------------------------- */
LoadingIndicator {
    color: #3b82f6;
}

/* ----- Selection highlight -------------------------------------------- */
/* Note: Textual handles selection styling internally via design tokens. */
